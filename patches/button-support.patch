diff --git a/src/button_task.py b/src/button_task.py
new file mode 100644
index 0000000..46e5f4f
--- /dev/null
+++ b/src/button_task.py
@@ -0,0 +1,177 @@
+import logging
+import threading
+import time
+from datetime import timedelta
+
+logger = logging.getLogger(__name__)
+
+
+class ButtonTask:
+    """Watches Pimoroni Inky hardware buttons (A/B/C/D) and triggers app actions.
+
+    A: next plugin in playlist
+    B: previous plugin in playlist
+    C: force-refresh the current plugin
+    D: pause/resume automatic interval-based cycling
+    """
+
+    DEFAULT_BUTTON_GPIO = {"a": 5, "b": 6, "c": 16, "d": 24}
+    DEFAULT_BUTTON_ACTIONS = {"a": "next", "b": "previous", "c": "refresh", "d": "pause"}
+    DEFAULT_DEBOUNCE_SECONDS = 1.0
+    POLL_TIMEOUT_SECONDS = 0.25
+
+    def __init__(self, device_config, refresh_task):
+        self.device_config = device_config
+        self.refresh_task = refresh_task
+        self.thread = None
+        self.running = False
+        self.request = None
+        self.offset_to_button = {}
+        self.last_press_time = {}
+
+    def start(self):
+        """Start watching buttons A-D when button controls are enabled for Inky hardware."""
+        if not self.is_enabled():
+            logger.info("Button controls disabled or unsupported for this display type")
+            return False
+
+        if self.thread and self.thread.is_alive():
+            return True
+
+        self.running = True
+        self.thread = threading.Thread(target=self._run, daemon=True)
+        self.thread.start()
+        logger.info("Started Inky button task")
+        return True
+
+    def stop(self):
+        """Stop watching button events."""
+        self.running = False
+
+        if self.thread and self.thread.is_alive():
+            logger.info("Stopping Inky button task")
+            self.thread.join(timeout=2)
+
+        if self.thread and self.thread.is_alive():
+            self._close_request()
+
+    def is_enabled(self):
+        """Return whether button controls should run for the current config."""
+        if self.device_config.get_config("display_type", default="inky") != "inky":
+            return False
+
+        return True
+
+    def _run(self):
+        try:
+            self.request, self.offset_to_button = self._request_button_lines()
+            while self.running:
+                for event in self._read_events(self.request):
+                    self._handle_button_event(event)
+        except ImportError as e:
+            logger.warning(f"Inky button controls unavailable; missing GPIO dependency: {e}")
+        except Exception:
+            logger.exception("Inky button task stopped after an unexpected error")
+        finally:
+            self.running = False
+            self._close_request()
+
+    def _request_button_lines(self):
+        import gpiod
+        import gpiodevice
+        from gpiod.line import Bias, Direction, Edge
+
+        input_settings = gpiod.LineSettings(
+            direction=Direction.INPUT,
+            bias=Bias.PULL_UP,
+            edge_detection=Edge.FALLING,
+        )
+
+        chip = gpiodevice.find_chip_by_platform()
+        offset_to_button = {}
+        for button, default_gpio in self.DEFAULT_BUTTON_GPIO.items():
+            gpio = int(self.device_config.get_config(f"button_{button}_gpio", default=default_gpio))
+            offset = chip.line_offset_from_id(gpio)
+            offset_to_button[offset] = button
+            logger.info(f"Listening for Inky button {button.upper()} on GPIO {gpio}")
+
+        line_config = dict.fromkeys(offset_to_button.keys(), input_settings)
+        request = chip.request_lines(consumer="inkypi-buttons", config=line_config)
+        return request, offset_to_button
+
+    def _read_events(self, request):
+        if hasattr(request, "wait_edge_events"):
+            if not request.wait_edge_events(timeout=timedelta(seconds=self.POLL_TIMEOUT_SECONDS)):
+                return []
+            return request.read_edge_events()
+
+        time.sleep(self.POLL_TIMEOUT_SECONDS)
+        return request.read_edge_events()
+
+    def _handle_button_event(self, event):
+        button = self.offset_to_button.get(event.line_offset)
+        if not button:
+            return
+
+        now = time.monotonic()
+        debounce_seconds = float(
+            self.device_config.get_config("button_debounce_seconds", default=self.DEFAULT_DEBOUNCE_SECONDS)
+        )
+        if now - self.last_press_time.get(button, 0) < debounce_seconds:
+            logger.debug(f"Ignoring debounced Inky button {button.upper()} press")
+            return
+        self.last_press_time[button] = now
+
+        button_actions = self.device_config.get_config("button_actions", default={})
+        action = button_actions.get(button, self.DEFAULT_BUTTON_ACTIONS.get(button))
+
+        # Simple actions are a plain string; "jump to plugin" and "switch playlist"
+        # carry extra parameters, so they're stored as a small dict instead.
+        if isinstance(action, dict):
+            action_type = action.get("type")
+        else:
+            action_type = action
+
+        if action_type == "next":
+            logger.info(f"Inky button {button.upper()} pressed; cycling to next plugin")
+            self.refresh_task.cycle_playlist_next()
+        elif action_type == "previous":
+            logger.info(f"Inky button {button.upper()} pressed; cycling to previous plugin")
+            self.refresh_task.cycle_playlist_previous()
+        elif action_type == "refresh":
+            logger.info(f"Inky button {button.upper()} pressed; forcing refresh of current plugin")
+            self.refresh_task.force_refresh_current()
+        elif action_type == "pause":
+            paused = self.refresh_task.toggle_pause()
+            logger.info(f"Inky button {button.upper()} pressed; playlist auto-cycling {'paused' if paused else 'resumed'}")
+        elif action_type == "plugin":
+            playlist_name, plugin_id, instance_name = action.get("playlist"), action.get("plugin_id"), action.get("instance")
+            if playlist_name and plugin_id and instance_name:
+                logger.info(f"Inky button {button.upper()} pressed; jumping to plugin '{instance_name}' in playlist '{playlist_name}'")
+                self.refresh_task.jump_to_plugin(playlist_name, plugin_id, instance_name)
+            else:
+                logger.warning(f"Inky button {button.upper()}: 'plugin' action is missing playlist/plugin_id/instance")
+        elif action_type == "plugin_type":
+            playlist_name, plugin_id = action.get("playlist"), action.get("plugin_id")
+            if playlist_name and plugin_id:
+                logger.info(f"Inky button {button.upper()} pressed; jumping to plugin type '{plugin_id}' in playlist '{playlist_name}'")
+                self.refresh_task.jump_to_plugin_type(playlist_name, plugin_id)
+            else:
+                logger.warning(f"Inky button {button.upper()}: 'plugin_type' action is missing playlist/plugin_id")
+        elif action_type == "playlist":
+            playlist_name = action.get("playlist")
+            if playlist_name:
+                logger.info(f"Inky button {button.upper()} pressed; switching to playlist '{playlist_name}'")
+                self.refresh_task.switch_to_playlist(playlist_name)
+            else:
